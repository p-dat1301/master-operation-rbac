DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/masterop
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_google_ai_studio_api_key_here
RAG_LLM_GATEWAY_BASE_URL=http://llm_gateway:4000/v1
RAG_LLM_GATEWAY_API_KEY=sk-change-me-for-local-gateway
RAG_ANSWER_MODEL=gemini-flash
RAG_ANSWER_TIMEOUT_SECONDS=30
RAG_ANSWER_MAX_CONTEXT_TOKENS=8000
RAG_ANSWER_OUTPUT_TOKEN_RESERVE=512
# Elasticsearch retrieval is disabled by default for safe rollout.
RAG_USE_ELASTICSEARCH=false
# Elasticsearch host:port for local development.
ELASTICSEARCH_HOST=localhost:9200
# Elasticsearch index used for agentic chunk retrieval.
ELASTICSEARCH_INDEX_NAME=agentic_chunks
